# Host-specific GPU pinning for nite-eval.
# Copy this file to `secret.yaml` (gitignored), fill in the UUIDs from
# `nvidia-smi -L`, and apply separately:
#
#   kubectl apply -f k8s/base/secret.yaml
#
# Do NOT commit the populated file. The example is what kustomize references;
# the real secret is applied out-of-band.

apiVersion: v1
kind: Secret
metadata:
  name: nite-eval-gpu-pinning
  namespace: nite-eval
type: Opaque
stringData:
  # Output of `nvidia-smi -L`, full UUID including the "GPU-" prefix.
  TARGET_GPU_UUID: "GPU-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"  # RTX 3090
  JUDGE_GPU_UUID:  "GPU-YYYYYYYY-YYYY-YYYY-YYYY-YYYYYYYYYYYY"  # Tesla P40
