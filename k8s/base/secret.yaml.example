# Host-specific GPU pinning for nite-eval.
# Copy this file to `secret.yaml` (gitignored), fill in the UUIDs from
# `nvidia-smi -L`, and apply separately:
#
#   kubectl apply -f k8s/base/secret.yaml
#
# Do NOT commit the populated file. The example is what kustomize references;
# the real secret is applied out-of-band.

apiVersion: v1
kind: Secret
metadata:
  name: nite-eval-gpu-pinning
  namespace: nite-eval
type: Opaque
stringData:
  # Output of `nvidia-smi -L`, full UUID including the "GPU-" prefix.
  TARGET_GPU_UUID: "GPU-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"  # RTX 3090
  JUDGE_GPU_UUID:  "GPU-YYYYYYYY-YYYY-YYYY-YYYY-YYYYYYYYYYYY"  # Tesla P40

---
# Frontier-model API keys. Only needed when eval_config.yaml has models — or a
# judge.frontier block — with a `provider:` other than local. Both orchestrator
# manifests mount this with `optional: true`, so a local-only cluster can skip
# it. Copy into the same gitignored `secret.yaml` and apply out-of-band; do NOT
# commit populated keys.
#
# Set cost.max_usd in the eval ConfigMap before the first unattended API run —
# an overnight CronJob is exactly where an uncapped bill accumulates unnoticed.
apiVersion: v1
kind: Secret
metadata:
  name: nite-eval-api-keys
  namespace: nite-eval
type: Opaque
stringData:
  ANTHROPIC_API_KEY: ""
  OPENAI_API_KEY: ""
  # Any gateway named by a model's `api_key_env` field:
  OPENROUTER_API_KEY: ""
